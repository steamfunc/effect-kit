{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/oddpoet/SteamFunc/effect-kit/.claude/hooks/check-path.sh",
            "statusMessage": "경로 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/oddpoet/SteamFunc/effect-kit/.claude/hooks/pr-checklist.sh",
            "statusMessage": "PR 체크리스트 확인 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/oddpoet/SteamFunc/effect-kit && ./gradlew detekt test 2>&1 | tail -20",
            "timeout": 120,
            "statusMessage": "detekt + test 실행 중..."
          }
        ]
      }
    ]
  }
}
